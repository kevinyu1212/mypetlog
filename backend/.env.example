# Server
PORT=5000
# 배포 시 프론트 URL (CORS, 쉼표로 여러 개 가능)
# FRONTEND_URL=https://your-app.vercel.app

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=mypetlog

# JWT
JWT_SECRET=your_jwt_secret_key

# ── Cloudinary ──────────────────────────────────────────────
# 1) https://cloudinary.com 가입 후 Dashboard 접속
# 2) 아래 3개 값을 복사해서 붙여넣기
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 테스트용 (npm run test:api)
# TEST_EMAIL=          # 비워두면 DB 첫 번째 사용자 사용
TEST_PASSWORD=
